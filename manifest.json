{
  "name": "ARR Project Suite",
  "short_name": "ARR Suite",
  "description": "Field tools, monitoring and management for ARR carbon projects — plantation mapping, soil assessment, GPS vector capture.",
  "start_url": "/ARRmapper/index.html",
  "scope": "/ARRmapper/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
